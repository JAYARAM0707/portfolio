# ==========================================
# Node / React (frontend)
# ==========================================
node_modules/
dist/
dist-ssr/
*.local
.vite/
.cache/
coverage/
*.tsbuildinfo

# Env files — never commit secrets
.env
.env.*
!.env.example

# ==========================================
# Sensitive files (extra paranoia)
# ==========================================
*.pem              # SSL certificates / private keys
*.key              # API keys / private keys
*.crt              # Certificates
.env.production    # Production env vars (just in case)
credentials.json   # Service account files (e.g., Google, AWS)
*.sqlite           # Local databases
*.db               # Local databases

# ==========================================
# Python (backend)
# ==========================================
venv/
env/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.Python
*.egg-info/
*.egg
build/
develop-eggs/
.installed.cfg

# ==========================================
# Editor / IDE / OS
# ==========================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# Logs & temp
# ==========================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock

